pkgname=phasor-shell
pkgver=1.0.0
pkgrel=1
pkgdesc='Portable Quickshell desktop shell for MangoWM'
arch=('any')
url='https://github.com/tzachmost/phasor'
license=('MIT')
depends=('mangowm-git' 'quickshell' 'python' 'xdg-utils' 'wl-clipboard' 'glib2' 'swaybg' 'cliphist' 'swaync' 'flameshot')
optdepends=(
  'playerctl: MPRIS controls'
  'nautilus: reveal files in the default file manager'
  'brightnessctl: brightness controls'
  'wireplumber: audio controls via wpctl'
  'networkmanager: network status and Wi-Fi controls'
  'bluez: Bluetooth status and power controls'
  'polkit-gnome: authentication agent'
)
conflicts=('phasor-shell-git')
replaces=('phasor-shell-git')
source=("phasor-${pkgver}.tar.gz::https://github.com/tzachmost/phasor/releases/download/v${pkgver}/phasor-${pkgver}.tar.gz")
sha256sums=('7469883bf23e838e8d7072a9299f458a92f63ece805c4fa2cf5134ae69b2c0a8')

package() {
  cd "$srcdir/phasor-$pkgver"
  local dest="$pkgdir/usr/share/phasor"
  install -d "$dest"
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/wayland-sessions"
  tar -c --exclude='__pycache__' --exclude='*.py[co]' --exclude='*.egg-info' \
    -f - README.md AGENTS.md LICENSE shell plugins core config session scripts docs |
    tar -x -f - -C "$dest"
  printf 'Managed by the Phasor Arch package.\n' > "$dest/.phasor-managed"
  chmod 644 "$dest/.phasor-managed"
  find "$dest" -type f ! -name '.phasor-managed' ! -name '.phasor-owned-files' -printf '%P\n' > "$dest/.phasor-owned-files"
  chmod 644 "$dest/.phasor-owned-files"
  ln -s ../share/phasor/scripts/phasorctl "$pkgdir/usr/bin/phasorctl"
  ln -s ../share/phasor/scripts/phasor-core "$pkgdir/usr/bin/phasor-core"
  ln -s ../share/phasor/scripts/phasor-doctor "$pkgdir/usr/bin/phasor-doctor"
  ln -s ../share/phasor/session/phasor-session "$pkgdir/usr/bin/phasor-session"
  install -d "$pkgdir/usr/share/wayland-sessions"
  cat > "$pkgdir/usr/share/wayland-sessions/phasor.desktop" <<'EOF'
[Desktop Entry]
Name=Phasor
Comment=Phasor Shell on MangoWM
Exec=/usr/bin/phasor-session
TryExec=/usr/bin/phasor-session
Type=Application
DesktopNames=Phasor;Mango;
X-Phasor-Managed=true
EOF
  chmod 644 "$pkgdir/usr/share/wayland-sessions/phasor.desktop"
}
