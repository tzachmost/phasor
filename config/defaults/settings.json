{
  "schemaVersion": 1,
  "appearance": {
    "theme": "dark",
    "accent": "#8bd5ca",
    "reducedMotion": false,
    "wallpaper": ""
  },
  "launcher": {
    "shortcut": "Super+Space",
    "showRecents": false,
    "favorites": []
  },
  "commands": {
    "shortcut": "Super+/"
  },
  "settings": {
    "shortcut": "Super+,"
  },
  "spaces": {
    "count": 9,
    "animationDuration": 200
  },
  "windows": {
    "focusMode": "click",
    "raiseOnFocus": true
  },
  "dock": {
    "showCloseButtons": true,
    "showEmptyState": true
  },
  "plugins": {
    "dev.phasor.bar": {
      "enabled": true
    },
    "dev.phasor.dock": {
      "enabled": true
    },
    "dev.phasor.desktop": {
      "enabled": false
    },
    "dev.phasor.clipboard": {
      "enabled": true
    },
    "dev.phasor.launcher": {
      "enabled": true
    },
    "dev.phasor.notifications": {
      "enabled": true
    },
    "dev.phasor.screenshot": {
      "enabled": true
    },
    "dev.phasor.settings": {
      "enabled": true
    },
    "dev.phasor.commands": {
      "enabled": true
    }
  },
  "tiling": {
    "layout": "grid",
    "innerHorizontal": 8,
    "innerVertical": 8,
    "outerHorizontal": 10,
    "outerVertical": 10,
    "smartGaps": false,
    "borderWidth": 2,
    "hideSingleBorder": false,
    "masterCount": 1,
    "masterRatio": 0.55,
    "newIsMaster": true,
    "scrollerWidth": 0.8,
    "centerScroller": false,
    "preferCenter": false,
    "smartSplit": false,
    "preserveSplit": false
  }
}
