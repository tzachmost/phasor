#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
OUTPUT_DIR="${1:-$ROOT/package/fedora/RPMS}"
VERSION="$(python3 -c 'import pathlib, sys, tomllib; print(tomllib.loads(pathlib.Path(sys.argv[1]).read_text())["project"]["version"])' "$ROOT/pyproject.toml")"

if ! command -v rpmbuild >/dev/null 2>&1; then
    printf 'rpmbuild is not installed. Install Fedora package rpm-build first.\n' >&2
    exit 1
fi

BUILD_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/phasor-rpm.XXXXXXXX")"
trap 'rm -rf -- "$BUILD_ROOT"' EXIT
mkdir -p "$BUILD_ROOT/BUILD" "$BUILD_ROOT/BUILDROOT" "$BUILD_ROOT/RPMS" \
    "$BUILD_ROOT/SOURCES" "$BUILD_ROOT/SPECS" "$BUILD_ROOT/SRPMS"

tar -czf "$BUILD_ROOT/SOURCES/phasor-$VERSION.tar.gz" \
    --exclude='.git' \
    --exclude='__pycache__' \
    --exclude='*.py[co]' \
    --exclude='*.egg-info' \
    --exclude='dist' \
    --exclude='package/fedora/RPMS' \
    --transform="s,^phasor$,phasor-$VERSION,;s,^phasor/,phasor-$VERSION/," \
    -C "$(dirname "$ROOT")" "$(basename "$ROOT")"
sed "s/@PHASOR_VERSION@/$VERSION/g" \
    "$ROOT/package/fedora/phasor-shell.spec" \
    > "$BUILD_ROOT/SPECS/phasor-shell.spec"

mkdir -p "$OUTPUT_DIR"
rpmbuild \
    --define "_topdir $BUILD_ROOT" \
    --define "_rpmdir $OUTPUT_DIR" \
    --define "_srcrpmdir $OUTPUT_DIR" \
    -ba "$BUILD_ROOT/SPECS/phasor-shell.spec"
printf 'Built Phasor RPMs in %s\n' "$OUTPUT_DIR"
