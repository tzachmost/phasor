#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PHASOR_SETTINGS_ROOT="$(dirname "$(dirname "$SCRIPT_PATH")")"
PHASOR_SETTINGS_SECTION="${1:-}"
case "$PHASOR_SETTINGS_SECTION" in
    ''|appearance|shell|system|shortcuts|tiling|mango|about) ;;
    *) printf 'Unknown Settings page: %s\n' "$PHASOR_SETTINGS_SECTION" >&2; exit 2 ;;
esac
export PHASOR_SETTINGS_SECTION
if quickshell ipc --path "$PHASOR_SETTINGS_ROOT/settings.qml" call settings show "$PHASOR_SETTINGS_SECTION" >/dev/null 2>&1; then
    exit 0
fi
exec quickshell --no-duplicate --path "$PHASOR_SETTINGS_ROOT/settings.qml"
