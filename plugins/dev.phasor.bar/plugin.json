{
  "id": "dev.phasor.bar",
  "name": "Phasor Bar",
  "version": "0.1.0",
  "apiVersion": 1,
  "entrypoint": "Bar.qml",
  "categories": ["surface", "bar", "status-item"],
  "capabilities": ["spaces.read", "spaces.control", "settings.read", "settings.control", "tray.read"],
  "permissions": [],
  "supportedSlots": ["bar.left", "bar.right"],
  "contributions": [],
