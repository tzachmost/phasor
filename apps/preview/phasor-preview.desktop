[Desktop Entry]
Name=Preview
GenericName=Document Viewer
Comment=View and mark up PDFs and images
Exec=phasor-preview %f
TryExec=phasor-preview
Icon=document-preview
Terminal=false
Type=Application
Categories=Graphics;Office;Viewer;
MimeType=application/pdf;image/png;image/jpeg;image/webp;image/svg+xml;image/bmp;image/gif;image/tiff;
StartupNotify=true
X-Phasor-Managed=true
